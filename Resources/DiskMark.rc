IDD_CONFIG DIALOGEX 0, 0, 236, 158
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Benchmark Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Disk drive:",IDC_STATIC,10,12,60,8
    COMBOBOX        IDC_DISKDRIVE,76,10,150,100,CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Block size:",IDC_STATIC,10,31,60,8
    EDITTEXT        IDC_BLOCKSIZE,76,29,150,14,ES_AUTOHSCROLL
    LTEXT           "Test file size:",IDC_STATIC,10,50,60,8
    EDITTEXT        IDC_FILESIZE,76,48,150,14,ES_AUTOHSCROLL
    LTEXT           "Duration (sec):",IDC_STATIC,10,69,60,8
    EDITTEXT        IDC_DURATION,76,67,150,14,ES_AUTOHSCROLL
    CONTROL         "Allow OS write caching (flush is timed)",IDC_ALLOWCACHING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,76,86,150,10
    LTEXT           "Writes run for the duration, then reads run for the same time, sampled once per second. Sizes accept expressions such as 64 * 1024. Reads always bypass the OS cache.",IDC_CFGHINT,10,102,216,30
    PUSHBUTTON      "Help",IDC_CMDHELP,10,137,45,14
    PUSHBUTTON      "About",IDC_CMDABOUT,62,137,45,14
    PUSHBUTTON      "Cancel",IDC_CMDCANCEL,126,137,45,14
    DEFPUSHBUTTON   "Start",IDC_CMDOK,181,137,45,14
END

